{
  "name": "voku/agent-decision",
  "description": "Provider-neutral bounded decision advice with explicit human authority and privacy boundaries",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/voku/agent-decision",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "voku\\AgentDecision\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "voku\\AgentDecision\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit tests --display-warnings --fail-on-warning",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=512M",
    "cs": "php-cs-fixer check --config=.php-cs-fixer.dist.php --diff --show-progress=none",
    "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --show-progress=none",
    "ci": [
      "@test",
      "@phpstan",
      "@cs"
    ]
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "keywords": [
    "agents",
    "decisions",
    "advisory",
    "provider-neutral",
    "php"
  ]
}
